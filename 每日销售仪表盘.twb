              <calculation class='tableau' formula='#2020-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qt0nni05py8dm156ev2o0zcilnr'>
            <column caption='上月客单价' datatype='real' name='[Calculation_0059299192819718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_0157292965191685])/SUM([上个月成交金额 (复制)_0059299191562241]))' />
